# Docker environment variables
# Copy this to .env.docker and customize

# Database credentials
# Generate password with: openssl rand -base64 16
POSTGRES_USER=kitelab
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=kitelab

# JWT Secret for API authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Zerodha API credentials (from developers.kite.trade)
KITE_API_KEY=your-api-key
KITE_API_SECRET=your-api-secret

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Email whitelist for authentication (comma-separated)
ALLOWED_EMAILS=your-email@gmail.com

# Debug mode (set to false for production-like testing)
DEBUG=false

# Committed so we know what we said publicly on what date.
!data/published/
!data/published/**
# Topic dossiers — regenerable, not committed. But keep the schema doc.
!data/topic_dossiers/SCHEMA.md
!experiments/final_portfolio/
!experiments/final_portfolio/**
*.csv
!data/static/*.csv
!data/static/**/*.csv
!data/static/*.md
!data/static/**/*.md
!data/final_portfolio/*.csv
!data/final_portfolio/*.md
!experiments/final_portfolio/**/*.csv
!experiments/final_portfolio/**/*.html
# Validator output for the GDF full backfill — documentation, not data
!tasks/gdf_full_backfill/*.csv


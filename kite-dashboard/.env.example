# API URL (Railway backend)
NEXT_PUBLIC_API_URL=https://your-railway-app.railway.app

# Supabase Auth (auth_stack_v2) — project URL + anon key.
# The anon key is public by design (RLS/auth enforce access). The
# service_role key must NEVER appear here or in any NEXT_PUBLIC_* var.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile (bot protection on the sign-in OTP flow).
# Optional in dev — the widget renders only when set. Pair with
# enabling captcha (provider: turnstile) in Supabase Auth settings.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Insights surface tri-state: off | admin | all (see src/lib/flags.ts)
NEXT_PUBLIC_INSIGHTS_ACCESS=admin

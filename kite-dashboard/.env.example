# API URL (Railway backend)
NEXT_PUBLIC_API_URL=https://your-railway-app.railway.app

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# SECURITY: Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Whitelist (comma-separated)
# SECURITY: Always set this in production to restrict access
ALLOWED_EMAILS=your-email@gmail.com

# Development only - Skip authentication
# WARNING: This is IGNORED in production (NODE_ENV=production)
# SKIP_AUTH=true
